{
  "name": "restaurant-ordering-backend",
  "version": "1.0.0",
  "description": "AI-Based Restaurant Ordering and Delivery Management System - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:setup": "psql -h ${DB_HOST:-localhost} -p ${DB_PORT:-5432} -U ${DB_USER:-postgres} -d ${DB_NAME:-food_delivery_db} -f database/schema.sql"
